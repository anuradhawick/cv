---
import Layout from '../layouts/Layout.astro';
import IntroSection from '../components/sections/IntroSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import EducationSection from '../components/sections/EducationSection.astro';
import PublicationsSection from '../components/sections/PublicationsSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import SoftwareSection from '../components/sections/SoftwareSection.astro';
import PresentationsSection from '../components/sections/PresentationsSection.astro';
import AwardsSection from '../components/sections/AwardsSection.astro';
import CertificationsSection from '../components/sections/CertificationsSection.astro';
import AdditionalInfoSection from '../components/sections/AdditionalInfoSection.astro';
---

<Layout>
  <div class="space-y-4">
    <!-- About / Intro -->
    <IntroSection />

    <!-- Work Experience -->
    <ExperienceSection />

    <!-- Education -->
    <EducationSection />

    <!-- Publications -->
    <PublicationsSection />

    <!-- Skills -->
    <SkillsSection />

    <!-- Software & Tools -->
    <SoftwareSection />

    <!-- Posters & Presentations -->
    <PresentationsSection />

    <!-- Awards & Achievements -->
    <AwardsSection />

    <!-- Training & Certifications -->
    <CertificationsSection />

    <!-- Additional Information -->
    <AdditionalInfoSection />
  </div>
</Layout>
