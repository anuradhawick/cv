---
import skills from '../../data/skills.json';
import SectionContainer from '../SectionContainer.astro';
---

<SectionContainer id="skills" title={skills.sectionTitle}>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {skills.categories.map((category) => (
      <div class="cv-card rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-5 sm:p-6 shadow-xs transition hover:border-[var(--accent-color)]">
        <h3 class="text-xl font-bold text-[var(--text-primary)] pb-2 border-b border-[var(--border-color)]">
          {category.name}
        </h3>

        <ul class="mt-4 space-y-2 list-disc list-outside ml-5 text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
          {category.items.map((item) => (
            <li>{item}</li>
          ))}
        </ul>

        {category.note && (
          <p class="mt-4 pt-3 border-t border-[var(--border-color)] text-xs text-[var(--text-muted)] italic leading-relaxed">
            {category.note}
          </p>
        )}
      </div>
    ))}
  </div>
</SectionContainer>
