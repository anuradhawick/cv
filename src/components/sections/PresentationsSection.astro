---
import presentations from '../../data/presentations.json';
import SectionContainer from '../SectionContainer.astro';
---

<SectionContainer id="presentations" title={presentations.sectionTitle}>
  <div class="cv-card rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-5 sm:p-6 shadow-xs">
    <ul class="space-y-4">
      {presentations.items.map((item) => (
        <li class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 pb-4 border-b border-[var(--border-color)] last:border-0 last:pb-0">
          <div class="space-y-1 flex-1">
            <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)]">
              {item.event}
            </h3>
            <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
              {item.details}
            </p>
          </div>
          <span class="rounded-sm bg-[var(--bg-tertiary)] px-2 py-0.5 text-xs font-semibold text-[var(--text-muted)] border border-[var(--border-color)] self-start shrink-0">
            {item.year}
          </span>
        </li>
      ))}
    </ul>
  </div>
</SectionContainer>
