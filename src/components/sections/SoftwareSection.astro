---
import software from '../../data/software.json';
import SectionContainer from '../SectionContainer.astro';
---

<SectionContainer id="software" title={software.sectionTitle}>
  <div class="space-y-8">
    {software.groups.map((group) => (
      <div class="space-y-4">
        <h3 class="text-xl font-bold text-[var(--text-primary)] flex items-center gap-2">
          <span>{group.category}</span>
          <span class="text-xs font-normal text-[var(--text-muted)]">({group.items.length})</span>
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {group.items.map((item) => (
            <div class="cv-card rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-4 shadow-xs transition hover:border-[var(--accent-color)] flex flex-col justify-between">
              <div>
                <h4 class="text-base font-bold text-[var(--text-primary)] flex items-center justify-between gap-2">
                  <span>{item.name}</span>
                  {item.url && (
                    <a
                      href={item.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-[var(--text-muted)] hover:text-[var(--accent-color)] transition"
                      title={`Open ${item.name}`}
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    </a>
                  )}
                </h4>
                <p class="mt-1.5 text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
                  {item.description}
                </p>
              </div>

              {item.url && (
                <div class="mt-3 pt-2 border-t border-[var(--border-color)]">
                  <a
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs text-[var(--accent-color)] hover:underline break-all inline-flex items-center gap-1"
                  >
                    <span>{item.url.replace(/^https?:\/\/(www\.)?/, '')}</span>
                  </a>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</SectionContainer>
