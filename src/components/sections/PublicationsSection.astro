---
import publicationsData from '../../data/publications.json';
import SectionContainer from '../SectionContainer.astro';

const { publications, lastUpdated, scholarProfileUrl } = publicationsData;

// Compute summary stats
const totalPapers = publications.length;
const totalCitations = publications.reduce((acc, p) => acc + (p.citations || 0), 0);

// Get unique years sorted descending
const years = Array.from(new Set(publications.map(p => p.year).filter(y => y > 0))).sort((a, b) => b - a);
---

<SectionContainer id="publications" title="Publications">
  <div class="space-y-6">
    <!-- Meta & Google Scholar Source Badge -->
    <div class="flex flex-wrap items-center justify-between gap-4 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-4 shadow-xs">
      <div class="flex flex-wrap items-center gap-3 text-sm text-[var(--text-secondary)]">
        <span class="inline-flex items-center gap-1.5 rounded-md bg-[var(--bg-tertiary)] px-2.5 py-1 text-xs font-semibold text-[var(--text-primary)] border border-[var(--border-color)]">
          <svg class="w-3.5 h-3.5 text-[var(--accent-color)]" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z" />
          </svg>
          {totalPapers} Papers
        </span>
        <span class="inline-flex items-center gap-1.5 rounded-md bg-[var(--bg-tertiary)] px-2.5 py-1 text-xs font-semibold text-[var(--text-primary)] border border-[var(--border-color)]">
          <svg class="w-3.5 h-3.5 text-amber-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          {totalCitations} Citations
        </span>
        <span class="text-xs text-[var(--text-muted)]">
          Synced: <time>{lastUpdated}</time>
        </span>
      </div>

      <a
        href={scholarProfileUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] px-3 py-1.5 text-xs font-medium text-[var(--accent-color)] hover:border-[var(--accent-color)] transition"
      >
        <span>Google Scholar</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>

    <!-- Filter & Sort Bar -->
    <div class="no-print space-y-3 rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-4 text-sm shadow-xs">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <!-- Search -->
        <div class="relative flex-1 min-w-[220px]">
          <input
            type="text"
            id="pub-search-input"
            placeholder="Search papers by title, author, journal..."
            class="w-full rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] px-3 py-1.5 pl-9 text-xs text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:border-[var(--accent-color)] focus:outline-hidden"
          />
          <svg class="absolute left-2.5 top-2 w-3.5 h-3.5 text-[var(--text-muted)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>

        <!-- Sort Select -->
        <div class="flex items-center gap-2">
          <label for="pub-sort-select" class="text-xs text-[var(--text-muted)]">Sort by:</label>
          <select
            id="pub-sort-select"
            class="rounded-lg border border-[var(--border-color)] bg-[var(--bg-primary)] px-2.5 py-1.5 text-xs text-[var(--text-primary)] focus:border-[var(--accent-color)] focus:outline-hidden"
          >
            <option value="citations-desc">Most Cited</option>
            <option value="year-desc">Recent</option>
            <option value="year-asc">Oldest</option>
            <option value="citations-asc">Least Cited</option>
          </select>
        </div>
      </div>

      <!-- Quick Filter Buttons -->
      <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-[var(--border-color)]">
        <span class="text-xs text-[var(--text-muted)]">Quick views:</span>
        <button type="button" data-filter="all" class="pub-filter-btn rounded-md border border-[var(--accent-color)] bg-[var(--accent-color)] text-white px-2.5 py-1 text-xs font-medium transition cursor-pointer">
          All ({totalPapers})
        </button>
        <button type="button" data-filter="mostCited10" class="pub-filter-btn rounded-md border border-[var(--border-color)] bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-secondary)] hover:border-[var(--accent-color)] transition cursor-pointer">
          Top 10 Cited
        </button>
        <button type="button" data-filter="recent10" class="pub-filter-btn rounded-md border border-[var(--border-color)] bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-secondary)] hover:border-[var(--accent-color)] transition cursor-pointer">
          Recent 10
        </button>
        {years.slice(0, 3).map((y) => (
          <button type="button" data-filter={`year-${y}`} class="pub-filter-btn rounded-md border border-[var(--border-color)] bg-[var(--bg-secondary)] px-2.5 py-1 text-xs font-medium text-[var(--text-secondary)] hover:border-[var(--accent-color)] transition cursor-pointer">
            {y}
          </button>
        ))}
      </div>
    </div>

    <!-- Publications List -->
    <div id="publications-container" class="space-y-4">
      {publications.map((pub, idx) => (
        <article
          class="pub-card cv-card rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-4 sm:p-5 shadow-xs transition hover:border-[var(--accent-color)]"
          data-title={pub.title.toLowerCase()}
          data-authors={pub.authors.toLowerCase()}
          data-venue={pub.venue.toLowerCase()}
          data-year={pub.year}
          data-citations={pub.citations}
          data-index={idx}
        >
          <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3">
            <div class="flex-1 space-y-1.5">
              <h3 class="text-base sm:text-lg font-semibold text-[var(--text-primary)] leading-snug">
                {pub.titleUrl ? (
                  <a
                    href={pub.titleUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-[var(--accent-color)] transition"
                  >
                    {pub.title}
                  </a>
                ) : (
                  <span>{pub.title}</span>
                )}
              </h3>
              
              <p class="text-xs sm:text-sm text-[var(--text-secondary)]">
                {pub.authors}
              </p>

              {pub.venue && (
                <p class="text-xs text-[var(--text-muted)] italic">
                  {pub.venue}
                </p>
              )}
            </div>

            <!-- Citation Badge & Year -->
            <div class="flex sm:flex-col items-center sm:items-end justify-between gap-2 shrink-0">
              {pub.year > 0 && (
                <span class="rounded-sm bg-[var(--bg-tertiary)] px-2 py-0.5 text-xs font-semibold text-[var(--text-secondary)] border border-[var(--border-color)]">
                  {pub.year}
                </span>
              )}
              {pub.citations > 0 ? (
                pub.citationsUrl ? (
                  <a
                    href={pub.citationsUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 rounded-md bg-sky-500/10 border border-sky-500/30 px-2 py-0.5 text-xs font-semibold text-sky-600 dark:text-sky-300 hover:bg-sky-500/20 transition"
                    title={`${pub.citations} citations on Google Scholar`}
                  >
                    <span>★ {pub.citations} citations</span>
                  </a>
                ) : (
                  <span class="inline-flex items-center gap-1 rounded-md bg-sky-500/10 border border-sky-500/30 px-2 py-0.5 text-xs font-semibold text-sky-600 dark:text-sky-300">
                    ★ {pub.citations} citations
                  </span>
                )
              ) : null}
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Empty Search Result Fallback -->
    <div id="no-pub-results" class="hidden rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-8 text-center text-[var(--text-muted)]">
      <p>No publications match your search or filter.</p>
    </div>
  </div>
</SectionContainer>
