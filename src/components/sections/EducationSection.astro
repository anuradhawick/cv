---
import education from '../../data/education.json';
import SectionContainer from '../SectionContainer.astro';
---

<SectionContainer id="education" title={education.sectionTitle}>
  <div class="space-y-6">
    {education.items.map((edu) => (
      <div class="cv-card rounded-xl border border-[var(--border-color)] bg-[var(--card-bg)] p-5 sm:p-6 shadow-xs transition hover:border-[var(--accent-color)]">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 pb-2 border-b border-[var(--border-color)]">
          <div>
            <h3 class="text-xl sm:text-2xl font-bold text-[var(--text-primary)]">
              {edu.degree}
            </h3>
            <p class="text-base sm:text-lg font-medium text-[var(--accent-color)]">
              {edu.institution}
            </p>
          </div>
          <div class="text-xs sm:text-sm font-medium text-[var(--text-muted)]">
            <span>{edu.period}</span>
            {edu.location && <span> • {edu.location}</span>}
          </div>
        </div>

        <p class="mt-4 text-base text-[var(--text-secondary)] leading-relaxed">
          {edu.description}
        </p>

        {edu.highlights && edu.highlights.length > 0 && (
          <ul class="mt-3 space-y-1.5 list-disc list-outside ml-5 text-sm sm:text-base text-[var(--text-secondary)]">
            {edu.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </div>
    ))}
  </div>
</SectionContainer>
