---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import profile from '../data/profile.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} - Curriculum Vitae`,
  description = `Curriculum Vitae of ${profile.name}. Software Engineer at AML3D, former Solutions Architect at CSIRO. PhD in Computer Science from ANU.`
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/me-removebg.png" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/me-removebg.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cv.anuradhawick.com" />
    <meta property="og:image" content="/me-removebg.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      function applyTheme() {
        const stored = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        const isDark = stored
          ? stored === 'dark'
          : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', isDark);
      }

      applyTheme();

      if (typeof window !== 'undefined' && !window.__themeListenerAttached) {
        window.__themeListenerAttached = true;

        if (window.matchMedia) {
          const mediaQuery = window.matchMedia('(prefers-color-scheme: dark)');
          const handleSystemThemeChange = (e) => {
            // When system theme changes, sync theme and clear manual override so OS preference applies
            if (typeof localStorage !== 'undefined') {
              localStorage.removeItem('theme');
            }
            document.documentElement.classList.toggle('dark', e.matches);
          };

          if (mediaQuery.addEventListener) {
            mediaQuery.addEventListener('change', handleSystemThemeChange);
          }
        }

        window.addEventListener('storage', (e) => {
          if (e.key === 'theme') {
            applyTheme();
          }
        });

        document.addEventListener('astro:after-swap', applyTheme);
      }
    </script>
  </head>
  <body class="min-h-screen bg-[var(--bg-primary)] text-[var(--text-primary)] antialiased transition-colors duration-200">
    <!-- Mobile Header Bar (Phones / Tablets) -->
    <header id="mobile-header" class="lg:hidden sticky top-0 z-40 flex items-center justify-between border-b border-[var(--border-color)] bg-[var(--bg-primary)]/90 px-4 py-3 backdrop-blur-md no-print">
      <div class="flex items-center gap-2.5">
        <img src={profile.avatar} alt={profile.name} class="h-9 w-9 rounded-full border border-[var(--border-color)] object-cover bg-slate-200 dark:bg-slate-800" />
        <div>
          <h1 class="text-sm font-bold text-[var(--text-primary)]">{profile.shortName}</h1>
          <p class="text-[10px] text-[var(--text-muted)] uppercase tracking-wider">{profile.subTagline}</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <ThemeToggle />
        <button
          type="button"
          id="mobile-menu-toggle"
          class="p-2 rounded-lg border border-[var(--border-color)] bg-[var(--bg-secondary)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] focus:outline-hidden"
          aria-label="Toggle navigation and filters menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </header>

    <!-- Mobile Drawer Overlay -->
    <div id="mobile-drawer-backdrop" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-xs hidden transition-opacity lg:hidden no-print"></div>

    <!-- Mobile Drawer Content -->
    <div id="mobile-drawer" class="fixed inset-y-0 right-0 z-50 w-80 max-w-[85vw] bg-[var(--bg-secondary)] p-6 shadow-2xl border-l border-[var(--border-color)] overflow-y-auto transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden no-print">
      <div class="flex items-center justify-between mb-4 pb-2 border-b border-[var(--border-color)]">
        <span class="text-xs font-semibold text-[var(--text-muted)] uppercase tracking-wider">Navigation & Options</span>
        <button id="mobile-drawer-close" class="rounded-lg border border-[var(--border-color)] p-1.5 text-[var(--text-muted)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-tertiary)]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <Sidebar />
    </div>

    <!-- Main Layout Container -->
    <div class="mx-auto flex max-w-7xl">
      <!-- Desktop Sidebar -->
      <aside class="hidden lg:flex w-80 shrink-0 sticky top-0 h-screen flex-col overflow-y-auto border-r border-[var(--border-color)] bg-[var(--bg-secondary)] px-6 py-8 backdrop-blur-xs no-print">
        <Sidebar />
      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 px-4 sm:px-8 md:px-12 py-8 lg:py-12 max-w-4xl overflow-hidden">
        <slot />
      </main>
    </div>

    <!-- Interactive Client Script -->
    <script is:inline>
      (function() {
        const STORAGE_KEY = 'cv_sections_visibility_v1';

        // 1. Mobile Drawer
        const mobileToggle = document.getElementById('mobile-menu-toggle');
        const mobileClose = document.getElementById('mobile-drawer-close');
        const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
        const drawer = document.getElementById('mobile-drawer');

        function openDrawer() {
          drawerBackdrop?.classList.remove('hidden');
          drawer?.classList.remove('translate-x-full');
        }

        function closeDrawer() {
          drawerBackdrop?.classList.add('hidden');
          drawer?.classList.add('translate-x-full');
        }

        mobileToggle?.addEventListener('click', openDrawer);
        mobileClose?.addEventListener('click', closeDrawer);
        drawerBackdrop?.addEventListener('click', closeDrawer);

        // 2. Section Show/Hide Toggling
        const toggleInputs = document.querySelectorAll('.section-toggle-input');
        const resetBtn = document.getElementById('reset-sections-btn');
        const toggleAllBtn = document.getElementById('toggle-all-btn');
        const printBtns = document.querySelectorAll('#print-btn');

        let savedPrefs = {};
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (raw) savedPrefs = JSON.parse(raw);
        } catch (e) {
          console.warn('Could not read saved section preferences', e);
        }

        function applySectionVisibility(sectionId, visible) {
          const secEl = document.querySelector(`[data-section-id="${sectionId}"]`);
          const navLink = document.querySelector(`[data-nav-target="${sectionId}"]`);
          
          if (secEl) {
            if (visible) {
              secEl.classList.remove('hidden');
            } else {
              secEl.classList.add('hidden');
            }
          }
          if (navLink) {
            if (visible) {
              navLink.parentElement?.classList.remove('opacity-30', 'line-through');
            } else {
              navLink.parentElement?.classList.add('opacity-30', 'line-through');
            }
          }
        }

        // Initialize state
        toggleInputs.forEach(input => {
          const targetId = input.getAttribute('data-toggle-target');
          if (targetId && savedPrefs[targetId] !== undefined) {
            input.checked = Boolean(savedPrefs[targetId]);
          }
          applySectionVisibility(targetId, input.checked);

          input.addEventListener('change', () => {
            applySectionVisibility(targetId, input.checked);
            savedPrefs[targetId] = input.checked;
            try {
              localStorage.setItem(STORAGE_KEY, JSON.stringify(savedPrefs));
            } catch (e) {}
            // Sync duplicates (desktop vs drawer)
            document.querySelectorAll(`.section-toggle-input[data-toggle-target="${targetId}"]`).forEach(el => {
              if (el !== input) el.checked = input.checked;
            });
          });
        });

        // Reset button
        resetBtn?.addEventListener('click', () => {
          localStorage.removeItem(STORAGE_KEY);
          savedPrefs = {};
          toggleInputs.forEach(input => {
            input.checked = true;
            const targetId = input.getAttribute('data-toggle-target');
            applySectionVisibility(targetId, true);
          });
        });

        // Toggle All button
        let allShown = true;
        toggleAllBtn?.addEventListener('click', () => {
          allShown = !allShown;
          toggleInputs.forEach(input => {
            input.checked = allShown;
            const targetId = input.getAttribute('data-toggle-target');
            applySectionVisibility(targetId, allShown);
            savedPrefs[targetId] = allShown;
          });
          toggleAllBtn.textContent = allShown ? 'Hide All' : 'Show All';
          try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(savedPrefs));
          } catch (e) {}
        });

        // Print triggers
        printBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            window.print();
          });
        });

        // 3. Jump to section smooth scroll & drawer close
        document.querySelectorAll('.nav-link').forEach(link => {
          link.addEventListener('click', () => {
            const targetId = link.getAttribute('data-nav-target');
            const targetEl = document.getElementById(targetId);
            if (targetEl && targetEl.classList.contains('hidden')) {
              applySectionVisibility(targetId, true);
              const input = document.querySelector(`.section-toggle-input[data-toggle-target="${targetId}"]`);
              if (input) input.checked = true;
              savedPrefs[targetId] = true;
              try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(savedPrefs));
              } catch (e) {}
            }
            closeDrawer();
          });
        });

        // 4. ScrollSpy Active Highlight
        const sections = document.querySelectorAll('.cv-section');
        const navLinks = document.querySelectorAll('.nav-link');

        function onScroll() {
          const scrollPos = window.scrollY + 120;
          let currentId = '';

          sections.forEach(sec => {
            if (!sec.classList.contains('hidden')) {
              const top = sec.offsetTop;
              const height = sec.offsetHeight;
              if (scrollPos >= top && scrollPos < top + height) {
                currentId = sec.getAttribute('data-section-id');
              }
            }
          });

          navLinks.forEach(link => {
            const ind = link.querySelector('.nav-indicator');
            if (link.getAttribute('data-nav-target') === currentId) {
              link.classList.add('bg-[var(--bg-tertiary)]', 'text-[var(--accent-color)]', 'font-semibold');
              if (ind) ind.classList.remove('opacity-0');
            } else {
              link.classList.remove('bg-[var(--bg-tertiary)]', 'text-[var(--accent-color)]', 'font-semibold');
              if (ind) ind.classList.add('opacity-0');
            }
          });
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        // 5. Publications Interactivity
        const pubSearch = document.getElementById('pub-search-input');
        const pubSort = document.getElementById('pub-sort-select');
        const pubFilterBtns = document.querySelectorAll('.pub-filter-btn');
        const pubCards = Array.from(document.querySelectorAll('.pub-card'));
        const pubContainer = document.getElementById('publications-container');
        const noPubResults = document.getElementById('no-pub-results');

        let activeFilter = 'all';

        function updatePublications() {
          if (!pubContainer) return;
          const query = (pubSearch?.value || '').trim().toLowerCase();

          // Sort
          const sortVal = pubSort?.value || 'citations-desc';
          pubCards.sort((a, b) => {
            const citA = parseInt(a.getAttribute('data-citations') || '0', 10);
            const citB = parseInt(b.getAttribute('data-citations') || '0', 10);
            const yrA = parseInt(a.getAttribute('data-year') || '0', 10);
            const yrB = parseInt(b.getAttribute('data-year') || '0', 10);

            if (sortVal === 'citations-desc') return citB - citA || yrB - yrA;
            if (sortVal === 'citations-asc') return citA - citB || yrA - yrB;
            if (sortVal === 'year-desc') return yrB - yrA || citB - citA;
            if (sortVal === 'year-asc') return yrA - yrB || citB - citA;
            return 0;
          });

          const byCitations = [...pubCards].sort((a, b) => {
            return parseInt(b.getAttribute('data-citations') || '0', 10) - parseInt(a.getAttribute('data-citations') || '0', 10);
          }).slice(0, 10);

          const byYear = [...pubCards].sort((a, b) => {
            return parseInt(b.getAttribute('data-year') || '0', 10) - parseInt(a.getAttribute('data-year') || '0', 10);
          }).slice(0, 10);

          let visibleCount = 0;

          pubCards.forEach(card => {
            let matchesFilter = true;
            if (activeFilter === 'mostCited10') {
              matchesFilter = byCitations.includes(card);
            } else if (activeFilter === 'recent10') {
              matchesFilter = byYear.includes(card);
            } else if (activeFilter.startsWith('year-')) {
              const yr = activeFilter.replace('year-', '');
              matchesFilter = card.getAttribute('data-year') === yr;
            }

            let matchesQuery = true;
            if (query) {
              const title = card.getAttribute('data-title') || '';
              const authors = card.getAttribute('data-authors') || '';
              const venue = card.getAttribute('data-venue') || '';
              matchesQuery = title.includes(query) || authors.includes(query) || venue.includes(query);
            }

            if (matchesFilter && matchesQuery) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }

            pubContainer.appendChild(card);
          });

          if (noPubResults) {
            if (visibleCount === 0) {
              noPubResults.classList.remove('hidden');
            } else {
              noPubResults.classList.add('hidden');
            }
          }
        }

        pubSearch?.addEventListener('input', updatePublications);
        pubSort?.addEventListener('change', updatePublications);

        pubFilterBtns.forEach(btn => {
          btn.addEventListener('click', () => {
            pubFilterBtns.forEach(b => {
              b.classList.remove('bg-[var(--accent-color)]', 'text-white', 'border-[var(--accent-color)]');
              b.classList.add('bg-[var(--bg-secondary)]', 'text-[var(--text-secondary)]', 'border-[var(--border-color)]');
            });
            btn.classList.remove('bg-[var(--bg-secondary)]', 'text-[var(--text-secondary)]', 'border-[var(--border-color)]');
            btn.classList.add('bg-[var(--accent-color)]', 'text-white', 'border-[var(--accent-color)]');

            activeFilter = btn.getAttribute('data-filter') || 'all';
            updatePublications();
          });
        });
      })();
    </script>
  </body>
</html>
